# Vite — 접두사 VITE_ 만 브라우저에 노출됩니다.
# 복사 후 .env 또는 .env.local 로 저장하고 값 채우기 (이 파일에는 비밀번호를 커밋하지 마세요).

# ── Vercel 프론트 도메인 ──
# 메인넷 (Production / main):  https://marketpiepie.vercel.app
# 테스트넷 (Preview / test):   https://marketpiepietest.vercel.app
#
# Vercel 배포 시 vercel.json 이 /api → Lightsail 백엔드로 프록시하므로
# VITE_API_URL 은 보통 비워두면 됩니다. 별도 API 도메인을 쓸 때만 설정하세요.
# VITE_API_URL=
# VITE_API_BASE_URL=

# Supabase (Realtime 등 — 대시보드 → API Keys)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Pi SDK — Vercel 호스트명으로 자동 분기됨 (testnet / mainnet).
# 명시 오버라이드만 필요할 때:
# VITE_PI_SANDBOX=true   # 테스트넷
# VITE_PI_SANDBOX=false  # 메인넷

# 로컬 dev — Vite proxy 대상 (backend/.env PORT 와 맞춤)
# DEV_API_TARGET=http://localhost:4000
